{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Nox Energy API Documentation",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": "/favicon.ico",
  "redirects": [
    {
      "source": "/guides/energy-supplier-integration",
      "destination": "/guides/new-asset-integration"
    },
    {
      "source": "/guides/manufacturer-integration",
      "destination": "/guides/new-asset-integration"
    }
  ],
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "guides/introduction",
              "guides/get-started"
            ]
          },
          {
            "group": "Integration",
            "pages": [
              "guides/integration-overview",
              "guides/bring-your-own-connection",
              "guides/new-asset-integration"
            ]
          },
          {
            "group": "API Guides",
            "pages": [
              "guides/hp-api-guide",
              "guides/pv-api-guide",
              "guides/battery-api-guide",
              "guides/partner-webhooks"
            ]
          }
        ]
      },
      {
        "tab": "API Docs",
        "groups": [
          {
            "group": "API setup",
            "pages": [
              "api-docs/authentication"
            ]
          },
          {
            "group": "Connecting Users and Devices",
            "pages": [
              {
                "group": "By supplier (sunsetting)",
                "openapi": {
                  "source": "api-docs/supplier-integration/openapi-supplier-auth-v2.json",
                  "directory": "api-docs/supplier-integration"
                },
                "pages": [
                  "POST /supplier/link-sessions",
                  {
                    "group": "Deprecated",
                    "openapi": {
                      "source": "api-docs/supplier-integration/openapi-supplier-auth.json",
                      "directory": "api-docs/supplier-integration-deprecated"
                    },
                    "pages": [
                      "POST /users/{userId}/link"
                    ]
                  }
                ]
              },
              {
                "group": "By manufacturer (sunsetting)",
                "openapi": {
                  "source": "api-docs/manufacturer-integration/openapi-manufacturer-auth-v2.json",
                  "directory": "api-docs/manufacturer-integration"
                },
                "pages": [
                  "POST /manufacturer/link-sessions",
                  "POST /manufacturer/device-connections",
                  {
                    "group": "Deprecated",
                    "openapi": {
                      "source": "api-docs/manufacturer-integration/openapi-manufacturer-auth.json",
                      "directory": "api-docs/manufacturer-integration-deprecated"
                    },
                    "pages": [
                      "POST /manufacturers/nox",
                      "POST /manufacturers/suppliers"
                    ]
                  }
                ]
              },
              {
                "group": "By partner (sunsetting)",
                "openapi": {
                  "source": "api-docs/partner-integration/openapi-partner-auth.json",
                  "directory": "api-docs/partner-integration"
                },
                "pages": [
                  "POST /partner/link-sessions"
                ]
              },
              {
                "group": "Connections (preview)",
                "openapi": {
                  "source": "api-docs/connections/openapi-connections.json",
                  "directory": "api-docs/connections"
                },
                "pages": [
                  "POST /v2/connections/link",
                  "POST /v2/connections",
                  "GET /v2/connections",
                  "DELETE /v2/connections/{provider}",
                  "DELETE /v2/connections",
                  "GET /v2/connections/household",
                  "PATCH /v2/connections/household"
                ]
              }
            ]
          },
          {
            "group": "Manufacturer Package",
            "openapi": {
              "source": "api-docs/manufacturer/openapi-manufacturer.json",
              "directory": "api-docs/manufacturer"
            }
          },
          {
            "group": "HP",
            "openapi": {
              "source": "api-docs/hp/openapi-hp.json",
              "directory": "api-docs/hp"
            }
          },
          {
            "group": "PV",
            "openapi": {
              "source": "api-docs/pv/openapi-pv.json",
              "directory": "api-docs/pv"
            }
          },
          {
            "group": "Battery (preview)",
            "openapi": {
              "source": "api-docs/battery/openapi-battery.json",
              "directory": "api-docs/battery"
            }
          },
          {
            "group": "Households (preview)",
            "openapi": {
              "source": "api-docs/household/openapi-household.json",
              "directory": "api-docs/household"
            }
          }
        ]
      },
      {
        "tab": "Supported Assets",
        "groups": [
          {
            "group": "Supported Assets",
            "pages": [
              "supported-assets/supported-assets-overview"
            ]
          }
        ]
      },
      {
        "tab": "Changelog",
        "groups": [
          {
            "group": "Changelog",
            "pages": [
              "changelog/product-updates"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Blog",
          "href": "https://www.nox.energy/blog",
          "icon": "newspaper"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/no_background_1280w.svg",
    "dark": "/logo/no_background_1280w.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@nox.energy"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard Demo",
      "href": "https://nox-supplier.vercel.app/"
    }
  },
  "footer": {
    "socials": {
      "linkedin": "https://www.linkedin.com/company/energy-nox"
    }
  }
}
